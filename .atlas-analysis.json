  "keyFeatures": [
    "Role-based access control (Owner, Supervisor, Operator, Admin)",
    "Complete quotation to work order workflow",
    "Real-time production tracking and event logging",
    "Material consumption and inventory management",
    "Resource allocation (human and machine)",
    "Dashboard with KPIs and productivity reports",
    "Comprehensive audit trail",
    "Docker-based on-premise deployment"
